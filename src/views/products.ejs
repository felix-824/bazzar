<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>Bazzar Admin | Products</title>

    <link rel="stylesheet" href="/css/admin.css" />
</head>

<body>

    <!-- ========================================= -->
    <!-- 1. ADMIN PAGE UMUMIY CONTAINER            -->
    <!-- ========================================= -->

    <div class="admin-layout">

        <!-- ===================================== -->
        <!-- 2. CHAP TOMONDAGI SIDEBAR            -->
        <!-- ===================================== -->

        <%- include("includes/sidebar") %>


        <!-- ===================================== -->
        <!-- 3. O'NG TOMONDAGI ASOSIY QISM        -->
        <!-- ===================================== -->

        <main class="admin-main">

            <!-- ================================= -->
            <!-- 4. HEADER                         -->
            <!-- ================================= -->

            <%- include("includes/header", {
                pageTitle: "Products"
            }) %>


            <!-- ================================= -->
            <!-- 5. PRODUCTS CONTENT               -->
            <!-- ================================= -->

            <section class="admin-content">

                <!-- ============================= -->
                <!-- PRODUCTS TITLE / ADD BUTTON   -->
                <!-- ============================= -->

                <div class="content-heading">

                    <div>
                        <h2>Products</h2>

                        <p>
                            Manage products in your Bazzar store.
                        </p>
                    </div>

                    <a
                        href="#create-product"
                        class="add-product-btn"
                    >
                        + Add Product
                    </a>

                </div>


                <!-- ================================= -->
                <!-- 6. CREATE / EDIT PRODUCT FORM     -->
                <!-- ================================= -->

                <div
                    id="create-product"
                    class="admin-card create-product-card"
                >

                    <!--
                        Default holatda CREATE.

                        Edit bosilganda products.js:
                        Create New Product
                                ↓
                        Edit Product

                        qilib o'zgartiradi.
                    -->
                    <h3 id="product-form-title">
                        Create New Product
                    </h3>


                    <form
                        id="product-form"
                        action="/admin/product/create"
                        method="POST"
                        enctype="multipart/form-data"
                        class="product-form"
                    >

                        <!-- ========================= -->
                        <!-- PRODUCT NAME              -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Product Name
                            </label>

                            <input
                                type="text"
                                name="productName"
                                placeholder="Enter product name"
                                required
                            />

                        </div>


                        <!-- ========================= -->
                        <!-- COLLECTION                -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Collection
                            </label>

                            <select
                                name="productCollection"
                                required
                            >

                                <option value="">
                                    Select Collection
                                </option>

                                <option value="FRUIT_VEGETABLE">
                                    Fruit & Vegetable
                                </option>

                                <option value="MEAT">
                                    Meat
                                </option>

                                <option value="DAIRY">
                                    Dairy
                                </option>

                                <option value="BAKERY">
                                    Bakery
                                </option>

                                <option value="SNACK">
                                    Snack
                                </option>

                            </select>

                        </div>


                        <!-- ========================= -->
                        <!-- PRICE                     -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Price
                            </label>

                            <input
                                type="number"
                                name="productPrice"
                                min="0"
                                placeholder="0"
                                required
                            />

                        </div>


                        <!-- ========================= -->
                        <!-- STOCK                     -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Stock
                            </label>

                            <input
                                type="number"
                                name="productLeftCount"
                                min="0"
                                placeholder="0"
                                required
                            />

                        </div>


                        <!-- ========================= -->
                        <!-- UNIT                      -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Unit
                            </label>

                            <select
                                name="productUnit"
                                required
                            >

                                <option value="">
                                    Select Unit
                                </option>

                                <option value="PIECE">
                                    Piece
                                </option>

                                <option value="KG">
                                    KG
                                </option>

                                <option value="LITER">
                                    Liter
                                </option>

                            </select>

                        </div>


                        <!-- ========================= -->
                        <!-- VOLUME                    -->
                        <!-- ========================= -->

                        <div class="form-group">

                            <label>
                                Volume
                            </label>

                            <input
                                type="number"
                                name="productVolume"
                                min="0"
                                step="0.1"
                                placeholder="1"
                            />

                        </div>


                        <!-- ========================= -->
                        <!-- PRODUCT STATUS            -->
                        <!-- ========================= -->

                        <!--
                            MUHIM:

                            Yangi product yaratishda bu qism
                            ko'rinmaydi.

                            Chunki yangi product schema default
                            bo'yicha PAUSE bo'lib yaratiladi.

                            Faqat Edit bosilganda products.js
                            display:flex qiladi.

                            Shunda Admin:

                            PAUSE
                              ↓
                            PROCESS

                            yoki

                            PROCESS
                              ↓
                            DELETE

                            kabi statusni o'zgartira oladi.
                        -->

                        <div
                            class="form-group"
                            id="product-status-group"
                            style="display: none;"
                        >

                            <label>
                                Status
                            </label>

                            <select name="productStatus">

                                <option value="PAUSE">
                                    PAUSE
                                </option>

                                <option value="PROCESS">
                                    PROCESS
                                </option>

                                <option value="DELETE">
                                    DELETE
                                </option>

                            </select>

                        </div>


                        <!-- ========================= -->
                        <!-- DESCRIPTION               -->
                        <!-- ========================= -->

                        <div class="form-group form-group-full">

                            <label>
                                Description
                            </label>

                            <textarea
                                name="productDesc"
                                rows="4"
                                placeholder="Product description"
                            ></textarea>

                        </div>


                        <!-- ========================= -->
                        <!-- IMAGES                    -->
                        <!-- ========================= -->

                        <div class="form-group form-group-full">

                            <label>
                                Product Images
                            </label>

                            <input
                                type="file"
                                name="productImages"
                                accept="image/*"
                                multiple
                            />

                        </div>


                        <!-- ========================= -->
                        <!-- SUBMIT                    -->
                        <!-- ========================= -->

                        <div class="form-actions">

                            <button
                                id="product-submit-btn"
                                type="submit"
                                class="submit-btn"
                            >
                                Create Product
                            </button>

                        </div>

                    </form>

                </div>


                <!-- ================================= -->
                <!-- 7. PRODUCT TABLE                  -->
                <!-- ================================= -->

                <div class="admin-card product-table-card">

                    <div class="table-heading">

                        <div>
                            <h3>
                                Product List
                            </h3>

                            <p>
                                All products in your store
                            </p>
                        </div>

                    </div>


                    <div class="table-wrapper">

                        <table class="product-table">

                            <thead>

                                <tr>
                                    <th>No</th>
                                    <th>Product</th>
                                    <th>Collection</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Unit</th>
                                    <th>Volume</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>

                            </thead>


                            <tbody>

                                <% products.forEach(function(product, index) { %>

                                    <tr>

                                        <!-- NUMBER -->

                                        <td>
                                            <%= index + 1 %>
                                        </td>


                                        <!-- PRODUCT IMAGE + NAME -->

                                        <td>

                                            <div class="product-info">

                                                <% if (
                                                    product.productImages &&
                                                    product.productImages.length > 0
                                                ) { %>

                                                    <img
                                                        src="/<%= product.productImages[0] %>"
                                                        alt="<%= product.productName %>"
                                                        class="product-image"
                                                    />

                                                <% } else { %>

                                                    <div class="no-product-image">
                                                        No Image
                                                    </div>

                                                <% } %>


                                                <strong>
                                                    <%= product.productName %>
                                                </strong>

                                            </div>

                                        </td>


                                        <!-- COLLECTION -->

                                        <td>
                                            <%= product.productCollection %>
                                        </td>


                                        <!-- PRICE -->

                                        <td>
                                            ₩<%= Number(
                                                product.productPrice
                                            ).toLocaleString() %>
                                        </td>


                                        <!-- STOCK -->

                                        <td>
                                            <%= product.productLeftCount %>
                                        </td>


                                        <!-- UNIT -->

                                        <td>
                                            <%= product.productUnit %>
                                        </td>


                                        <!-- VOLUME -->

                                        <td>
                                            <%= product.productVolume %>
                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <span
                                                class="status-badge status-<%= product.productStatus.toLowerCase() %>"
                                            >
                                                <%= product.productStatus %>
                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td>

                                            <div class="table-actions">

                                                <!--
                                                    EDIT BUTTON

                                                    data-* ichida shu productning
                                                    ma'lumotlarini saqlab turamiz.

                                                    products.js Edit bosilganda
                                                    shu qiymatlarni formga joylaydi.
                                                -->

                                                <button
                                                    type="button"
                                                    class="edit-btn"

                                                    data-id="<%= product._id %>"
                                                    data-name="<%= product.productName %>"
                                                    data-collection="<%= product.productCollection %>"
                                                    data-price="<%= product.productPrice %>"
                                                    data-stock="<%= product.productLeftCount %>"
                                                    data-unit="<%= product.productUnit %>"
                                                    data-volume="<%= product.productVolume %>"
                                                    data-desc="<%= product.productDesc || '' %>"

                                                    data-status="<%= product.productStatus %>"
                                                >
                                                    Edit
                                                </button>


                                                <!--
                                                    Delete'ni keyingi bosqichda
                                                    backend soft delete bilan
                                                    ulaymiz.
                                                -->

                                                    <form
                                                        action="/admin/product/delete/<%= product._id %>"
                                                        method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this product?');"
                                                    >
                                                        <button
                                                            type="submit"
                                                            class="delete-btn"
                                                        >
                                                            Delete
                                                        </button>
                                                    </form>
                                                

                                            </div>

                                        </td>

                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>

                </div>

            </section>

        </main>

    </div>


    <!-- ========================================= -->
    <!-- PRODUCTS FRONTEND JS                      -->
    <!-- ========================================= -->

    <script src="/js/products.js"></script>

</body>

</html>
